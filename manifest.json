{
   "manifest_version": 3,
   "name": "Connectify",
   "version": "3.1.13",
   "description": "Subject progress graphs, assessment statistics, grade planning and a site-wide Connect theme.",
   "icons": {
      "128": "logo.png"
   },
   "permissions": [
      "storage"
   ],
   "browser_specific_settings": {
      "gecko": {
         "id": "connect-chart-tea@local",
         "strict_min_version": "140.0",
         "update_url": "https://raw.githubusercontent.com/TheFieryFalcon/connectify/updates/updates.json",
         "data_collection_permissions": {
            "required": [
               "none"
            ]
         }
      }
   },
   "content_scripts": [
      {
         "matches": [
            "https://connect.det.wa.edu.au/group/students/ui/my-settings/assessment-outlines*"
         ],
         "js": [
            "data.js"
         ],
         "run_at": "document_idle",
         "world": "MAIN"
      },
      {
         "matches": [
            "https://connect.det.wa.edu.au/group/students/ui/my-settings/assessment-outlines*"
         ],
         "css": [
            "atar.css",
            "progress.css",
            "sidebar.css"
         ],
         "js": [
            "assessment-data.js",
            "cohort-math.js",
            "task-types.js",
            "cohort-stats.js",
            "scaling-data.js",
            "atar-math.js",
            "atar-scraper.js",
            "atar-calculator.js",
            "atar-ui.js",
            "progress-math.js",
            "progress-chart.js",
            "progress-graph.js",
            "wace-countdown.js",
            "compound-progress.js",
            "atar-features.js",
            "sidebar.js",
            "dom-sweeper.js"
         ],
         "run_at": "document_idle"
      },
      {
         "matches": [
            "https://connect.det.wa.edu.au/*"
         ],
         "css": [
            "theme.css"
         ],
         "js": [
            "theme.js"
         ],
         "run_at": "document_idle"
      },
      {
         "matches": [
            "https://connect.det.wa.edu.au/*"
         ],
         "js": [
            "navigation.js"
         ],
         "run_at": "document_idle"
      },
      {
         "matches": [
            "https://login.det.wa.edu.au/*"
         ],
         "js": [
            "auto-login.js"
         ],
         "run_at": "document_end"
      }
   ],
   "key": "",
   "update_url": "https://raw.githubusercontent.com/TheFieryFalcon/connectify/updates/updates.xml"
}

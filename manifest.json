{
   "browser_specific_settings": {
      "gecko": {
         "id": "connect-chart-tea@local",
         "strict_min_version": "140.0",
         "update_url": "https://raw.githubusercontent.com/TheFieryFalcon/connectify/updates/updates.json",
         "data_collection_permissions": {
      			"required": ["none"]
    		}
        }
   },
   "content_scripts": [ {
      "css": [ "atar.css", "progress.css", "sidebar.css" ],
      "js": [ "assessment-data.js", "cohort-stats.js", "scaling-data.js", "atar-math.js", "atar-ui.js", "progress-graph.js", "atar-features.js", "sidebar.js" ],
      "matches": [ "https://connect.det.wa.edu.au/group/students/ui/my-settings/assessment-outlines*" ],
      "run_at": "document_idle",
      "world": "MAIN"
   }, {
      "css": [ "theme.css" ],
      "js": [ "theme.js" ],
      "matches": [ "https://connect.det.wa.edu.au/*" ],
      "run_at": "document_idle"
   }, {
      "js": [ "navigation.js" ],
      "matches": [ "https://connect.det.wa.edu.au/*" ],
      "run_at": "document_idle"
   }, {
      "js": [ "auto-login.js" ],
      "matches": [ "https://login.det.wa.edu.au/*" ],
      "run_at": "document_end"
   } ],
   "description": "Subject progress graphs, assessment statistics, grade planning and a site-wide Connect theme.",
   "icons": {
      "128": "logo.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Connectify",
   "permissions": [
      "storage"
   ],
   "update_url": "https://raw.githubusercontent.com/TheFieryFalcon/connectify/updates/updates.xml",
   "version": "3.1.8"
}
